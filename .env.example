# AdaptLearn Environment Variables
# Copy this file to .env and add your actual API keys

# ==================== LLM API Keys ====================
# For automatic resource generation
# You only need ONE of these APIs (Gemini recommended)

# Google Gemini API (Recommended)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (Optional alternative)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==================== Database Configuration ====================
# PostgreSQL settings (if using PostgreSQL)
# DB_NAME=adaptlearn_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# ==================== Django Settings ====================
# Secret key for Django (change in production)
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== Instructions ====================
# 1. Copy this file and rename it to: .env
# 2. Get a FREE Gemini API key from: https://makersuite.google.com/app/apikey
# 3. Replace 'your_gemini_api_key_here' with your actual API key
# 4. Save the file
# 5. Restart the Django server

# Note: Without an API key, the system will use fallback resource generation
# which creates search links instead of curated resources.
